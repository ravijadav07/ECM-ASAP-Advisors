              "sampleData": {},
              "sourceCode": {
                "code": "export const code = async (inputs) => {\n  const parseTally = (raw) => {\n    if (!raw) return [];\n    if (Array.isArray(raw) && raw.length > 0 && raw[0]['Json Agg']) {\n      try { return JSON.parse(raw[0]['Json Agg']); } catch(e) { return []; }\n    }\n    if (Array.isArray(raw)) return raw;\n    try { return JSON.parse(raw); } catch(e) { return []; }\n  };\n\n  const purchases = parseTally(inputs.purchase_data);\n  const sales = parseTally(inputs.sales_data);\n\n  const billedCostCentres = new Set();\n  sales.forEach(s => {\n    const cc = s.CostCentre || s.costCentre || s.cost_centre || '';\n    if (cc) billedCostCentres.add(cc.trim());\n  });\n\n  const rows = purchases.map((p, i) => {\n    const costCentre = (p.CostCentre || p.costCentre || '').trim();\n    const salesInvoiceNo = (p['Sales Invoice No.'] || p.salesInvoiceNo || p.sales_invoice_no || '').trim();\n    const supplier = p.Particulars || p.supplier || p.party || '';\n    const gstin = p['Party GSTIN/UIN'] || p.gstin || p.GSTIN || '';\n    const taxable = parseFloat(p['Taxable Amount'] || p.taxable || 0) || 0;\n    const tax = parseFloat(p['Tax Amount'] || p.tax || 0) || 0;\n    const invoice = p['Supplier Invoice No.'] || p.invoice || p.supplierInvoice || '';\n    const date = p.Date || p.date || '';\n\n    let salesStatus = 'COST CENTRE NOT ALLOCATED';\n    if (costCentre && !salesInvoiceNo) salesStatus = 'SALES BILL PENDING';\n    else if (costCentre && salesInvoiceNo) salesStatus = 'SALES BILL FOUND';\n\n    let bucket = 'B';\n    let bucketLabel = 'Deferred — Wait for Billing';\n    if (salesStatus === 'SALES BILL FOUND') { bucket = 'A'; bucketLabel = 'Claim Now'; }\n    if (salesStatus === 'COST CENTRE NOT ALLOCATED') { bucketLabel = 'Blocked — Cost Centre Missing'; }\n\n    return {\n      Date: date,\n      Supplier: supplier,\n      GSTIN: gstin,\n      'Voucher No': p['Vch No.'] || p.VchNo || p.VoucherNo || '',\n      'Taxable Amount': taxable,\n      'Tax Amount': tax,\n      'Cost Centre': costCentre,\n      'Sales Invoice No': salesInvoiceNo,\n      'Sales Status': salesStatus,\n      Bucket: bucket,\n      'Bucket Label': bucketLabel\n    };\n  });\n\n  const sheetRows = rows.map(r => ({\n    'Date': r.Date,\n    'Supplier': r.Supplier,\n    'GSTIN': r.GSTIN,\n    'Voucher No': r['Voucher No'],\n    'Taxable Amount': r['Taxable Amount'],\n    'Tax Amount': r['Tax Amount'],\n    'Cost Centre': r['Cost Centre'],\n    'Sales Invoice No': r['Sales Invoice No'],\n    'Sales Status': r['Sales Status'],\n    'Bucket': r.Bucket,\n    'Bucket Label': r['Bucket Label']\n  }));\n\n  return { rows: sheetRows, total_rows: sheetRows.length, bucket_a: rows.filter(r => r.Bucket === 'A').length, bucket_b: rows.filter(r => r.Bucket === 'B').length };\n};",
                "packageJson": "{}"
