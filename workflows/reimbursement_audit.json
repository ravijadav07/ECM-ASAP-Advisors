          "nextAction": {
            "name": "step_3",
            "type": "CODE",
            "valid": true,
            "skip": false,
            "displayName": "Compute Expense vs Recovery",
            "settings": {
              "input": {
                "cost_data": "{{step_1['content']}}",
                "recovery_data": "{{step_2['content']}}"
              },
              "sampleData": {},
              "sourceCode": {
                "code": "export const code = async (inputs) => {\n  const parseTally = (raw) => {\n    if (!raw) return [];\n    if (Array.isArray(raw) && raw.length > 0 && raw[0]['Json Agg']) {\n      try { return JSON.parse(raw[0]['Json Agg']); } catch(e) { return []; }\n    }\n    if (Array.isArray(raw)) return raw;\n    try { return JSON.parse(raw); } catch(e) { return []; }\n  };\n\n  const expenses = parseTally(inputs.cost_data);\n  const recoveries = parseTally(inputs.recovery_data);\n\n  const getNum = (v) => parseFloat(String(v || '0').replace(/[^0-9.-]/g, '')) || 0;\n\n  const map = {};\n  expenses.forEach(e => {\n    const cc = (e['Cost Centre'] || e.CostCentre || e.costCentre || '').trim();\n    const head = (e['Ledger'] || e.LedgerName || e.ledger || '').trim();\n    const customer = e['Party'] || e.PartyLedger || e.party || '';\n    const key = cc + '||' + head;\n    if (!map[key]) map[key] = { cc, head, customer, incurred: 0, recovered: 0 };\n    map[key].incurred += getNum(e['Debit Amount'] || e.DebitAmount || e.debit || 0);\n  });\n\n  recoveries.forEach(r => {\n    const cc = (r['Cost Centre'] || r.CostCentre || r.costCentre || '').trim();\n    const head = (r['Line Item Ledger'] || r.LineItemLedger || r.ledger || '').trim();\n    const key = cc + '||' + head;\n    if (map[key]) map[key].recovered += getNum(r['Line Item Amount'] || r.LineItemAmount || r.amount || 0);\n  });\n\n  let totalUnrecovered = 0;\n  const rows = Object.values(map).map(item => {\n    const variance = item.recovered - item.incurred;\n    let status = 'FULLY RECOVERED';\n    if (Math.abs(variance) <= 10) status = 'FULLY RECOVERED';\n    else if (variance < 0) { status = 'SHORT RECOVERED'; totalUnrecovered += Math.abs(variance); }\n    else status = 'OVER RECOVERED';\n    return {\n      'Cost Centre': item.cc,\n      'Customer': item.customer,\n      'Expense Head': item.head,\n      'Incurred': item.incurred,\n      'Recovered': item.recovered,\n      'Variance': variance,\n      'Status': status\n    };\n  });\n\n  return { rows: rows, total_rows: rows.length, total_unrecovered: totalUnrecovered };\n};",
                "packageJson": "{}"
