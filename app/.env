# ECM — Tally OS V3 (Vite-exposed). POC only.
# NOTE: These are exposed in the browser bundle. For production, route the
# webhook call through a server-side proxy (Supabase Edge Function) instead
# of exposing the secret client-side.

VITE_PUCHO_WEBHOOK_URL=https://studio.pucho.ai/api/v1/webhooks/YlGsYc3NdgNcUgnMh4ZYE/sync
VITE_PUCHO_WEBHOOK_SECRET=ECM
# Dev: /core-api uses Vite proxy → core-api.pucho.ai (no CORS).
# Production: auto-detected in tallyApi.js → uses https://core-api.pucho.ai directly.
VITE_PUCHO_CORE_API_BASE_URL=/core-api
