# =============================================================================
# ECM — Tally OS V3 Integration
# Multi-client deployment: swap these values per client. Never commit.
# =============================================================================

# ---- Auth (to call the TallyAuth workflow) ----
# POST to this webhook with body: { "token_key": "<secret>" }
# The workflow validates secretCode === incomingSecretKey, then returns
# accessToken + agentId from the Tally connection.
PUCHO_WEBHOOK_URL=https://studio.pucho.ai/api/v1/webhooks/YlGsYc3NdgNcUgnMh4ZYE/sync
PUCHO_WEBHOOK_SECRET=ECM

# ---- Tally Connection ----
# The UUID of the Tally connection inside AI Studio (used by the
# get_tally_connection step in the TallyAuth workflow).
TALLY_CONNECTION_ID=6dbd5e72-8731-474f-8946-370de762e121

# ---- Core API (where templates are executed) ----
PUCHO_CORE_API_BASE_URL=https://core-api.pucho.ai

# ---- Runtime (obtained from the workflow response, cached by the dashboard) ----
# PUCHO_ACCESS_TOKEN=<bearer token from TallyAuth workflow response>
# PUCHO_AGENT_ID=<agentId from TallyAuth workflow response; constant per Tally connection>

# ---- Endpoints (appended to CORE_API_BASE_URL) ----
# GET  /fapi/v1/pucho_piece/tally_templates_v3        → template catalogue (reference only)
# POST /fapi/v1/pucho_piece/execute_tally_template_v3  → execute a report template
#   Body: { "templateNo": <ID>, "agentId": "<agentId>", "type": "OS_RUN" }
#   Auth: Bearer <accessToken>